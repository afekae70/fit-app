<?xml version="1.0" encoding="utf-8"?>
<!--
  How the launcher offers and refreshes the widget.

  Two cells by one: the smallest shape that still fits the workout's name and a button, and the
  one most people have room for. It resizes both ways from there, and the layout holds at every
  size because the lines simply truncate.

  `updatePeriodMillis` is half an hour, which is the floor Android honours anyway — and enough
  for a label about today. Both a preview layout and a preview image are given: launchers that
  understand the first render the widget itself in the picker, and the rest fall back to the app's
  icon rather than to nothing at all. It also refreshes whenever it is placed, and whenever the app asks the
  launcher to update it after writing a new snapshot.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="58dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="110dp"
    android:minResizeHeight="58dp"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/today_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description"
    android:initialLayout="@layout/today_widget" />

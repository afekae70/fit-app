<?xml version="1.0" encoding="utf-8"?>
<!-- The app's card, as far as a launcher can draw one: rounded, with a hairline edge, in
     whichever half of the palette the phone is currently showing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_edge" />
</shape>

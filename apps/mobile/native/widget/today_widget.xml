<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's face.

  RemoteViews supports a small subset of the view system — no custom fonts, no gradients, no
  shadows — so this is the palette's lavender card, its violet accent, and three lines of text.
  Anything cleverer would not render in the launcher.

  Nothing here names a colour: they are all resources with a `values-night` twin, so the launcher
  draws the widget light or dark exactly as the phone is, and swaps it when the phone does.

  Every line carries default text, and that is not decoration: the launcher renders this very
  layout as the widget's preview in the picker, with no app running to fill it in. Without the
  defaults the preview was a blank white card — present in the list, and invisible in it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/today_widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_label"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_detail"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_start"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/today_widget_button"
        android:textColor="@color/widget_on_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

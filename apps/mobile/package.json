{
  "name": "@fit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "sdkNote": "Pinned to SDK 54 to match the installed Expo Go (54.x). Expo Go supports exactly ONE SDK version — from SDK 54 onward its app version mirrors the SDK number (54.0.8 serves SDK 54, 56.0.4 serves SDK 56). A mismatched project reports 'requires a newer version of Expo Go' no matter how up to date the store app is. Bump this only in lockstep with the Expo Go build on the device, or move to a development build (required for Bluetooth in Phase 4 anyway), which removes the constraint entirely.",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "vitest run"
  },
  "dependencies": {
    "@fit/shared": "*",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.3.6",
    "react": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.1",
    "react-native-health-connect": "^3.5.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  }
}

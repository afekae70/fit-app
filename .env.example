# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL="https://<project-ref>.supabase.co"

# The ANON key is safe to ship in the mobile app: Row Level Security is what protects
# the data, not the secrecy of this key.
SUPABASE_ANON_KEY="eyJ..."

# The SERVICE ROLE key BYPASSES Row Level Security entirely. It must never be bundled
# into the Expo app, committed, or exposed to a client. API service only, and only where
# admin access is genuinely required (the weekly recalculation cron).
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two different URLs, and using the wrong one causes confusing intermittent failures:
#
#   POOLED (port 6543, pgBouncer) — for the running API service.
#   DIRECT (port 5432)            — for `db:migrate` and `db:seed`. DDL through the
#                                   pooler is unreliable, and pgBouncer transaction mode
#                                   does not support prepared statements.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DATABASE_URL_DIRECT="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# AI coach — server-side only
# ---------------------------------------------------------------------------
# These keys must NEVER reach the mobile app. All model calls go through the API service;
# that is the main reason the API service exists at all.
AI_PROVIDER="claude"          # "claude" | "openai"

ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"   # cost lever: "claude-sonnet-5" is $3/$15 vs $5/$25

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
LOG_LEVEL="info"
